{% liquid
  assign strip_id = section.id | append: '-strip'
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  if section.settings.strip_background != blank
    render 'contrast-override', background_color: section.settings.strip_background, section_id: strip_id, preset: 'ui'
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--full-width
    gift-banner
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  data-testid="gift-banner"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if desktop_image != blank %}
      --gift-banner-ratio: {{ desktop_image.aspect_ratio }};
    {% endif %}
    --gift-cta-hover-background: {{ section.settings.button_hover_background }};
    --gift-cta-hover-text: {{ section.settings.button_hover_text }};
  "
>
  <div class="gift-banner__stage">
    {%- comment -%}
      One <picture>, so only the image for the current breakpoint is downloaded.
      Desktop: fills the stage behind the content. Mobile: sits below the text.
    {%- endcomment -%}
    <div class="gift-banner__media">
      {% if desktop_image != blank %}
        <picture>
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w,
                {{ mobile_image | image_url: width: 1500 }} 1500w
              "
              sizes="100vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
          {% endif %}
          {{
            desktop_image
            | image_url: width: 3840
            | image_tag:
              class: 'gift-banner__image',
              widths: '750, 1100, 1440, 1920, 2880, 3840',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: desktop_image.alt
          }}
        </picture>
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'gift-banner__image' }}
      {% endif %}
    </div>

    <div
      class="gift-banner__content gap-style"
      style="{% render 'gap-style', value: section.settings.content_gap %}"
    >
      {% content_for 'blocks' %}
    </div>

    <div class="gift-banner__cta gift-cta">
      {% content_for 'block', type: 'button', id: 'cta' %}
    </div>
  </div>

  <div class="gift-banner__strip{% if section.settings.strip_background != blank %} color-custom-{{ strip_id }}{% endif %}">
    {% content_for 'block', type: 'text', id: 'strip' %}
  </div>
</div>

{% stylesheet %}
  .gift-banner {
    /* 67px and 52px at the 1440 frame, scaling down on smaller screens */
    --gift-banner-inset: clamp(1.25rem, 4.65vw, 4.1875rem);
    --gift-banner-bottom: clamp(1.5rem, 3.6vw, 3.25rem);
    --gift-cta-height: 50px;
  }

  /* Desktop: illustration fills the stage, content anchored bottom-left */
  .gift-banner__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto auto;
    aspect-ratio: var(--gift-banner-ratio, 1440 / 780);
    padding: 0 var(--gift-banner-inset) var(--gift-banner-bottom);
    overflow: hidden;
  }

  .gift-banner__media {
    position: absolute;
    inset: 0;
  }

  .gift-banner__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gift-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .gift-banner__content {
    grid-row: 2;
    position: relative;
    z-index: var(--layer-flat);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap);
    max-width: 32rem;
  }

  .gift-banner__cta {
    grid-row: 3;
    position: relative;
    z-index: var(--layer-flat);
    justify-self: start;
    margin-block-start: var(--padding-2xl);
  }

  .gift-banner__strip {
    display: flex;
    justify-content: center;
    padding: var(--padding-xs) var(--padding-md);
  }

  /* Mobile: text centred above the illustration, button over its lower edge */
  @media screen and (max-width: 749px) {
    .gift-banner__stage {
      grid-template-rows: auto auto;
      aspect-ratio: auto;
      padding: 0;
    }

    .gift-banner__content {
      --text-align-default: center;

      grid-row: 1;
      align-items: center;
      max-width: none;
      padding: var(--padding-2xl) var(--padding-md) var(--padding-lg);
    }

    .gift-banner__media {
      position: relative;
      inset: auto;
      grid-row: 2;
      grid-column: 1;
    }

    .gift-banner__media picture,
    .gift-banner__image {
      height: auto;
    }

    .gift-banner__cta {
      grid-row: 2;
      grid-column: 1;
      align-self: end;
      justify-self: center;
      margin-block: 0 var(--padding-2xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "text"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "Desktop illustration. The banner takes its shape from this image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown under the text on small screens."
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "strip_background",
      "label": "Bottom strip background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#FFF544"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Gift banner",
      "settings": {
        "content_gap": 24
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<p>The Gift Guide</p>",
            "type_preset": "h1"
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>",
            "type_preset": "paragraph",
            "max_width": "narrow"
          }
        },
        "cta": {
          "type": "button",
          "name": "Button",
          "static": true,
          "settings": {
            "label": "SHOP NOW",
            "style_class": "button"
          }
        },
        "strip": {
          "type": "text",
          "name": "Bottom strip",
          "static": true,
          "settings": {
            "text": "<p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.75rem",
            "case": "uppercase",
            "width": "100%",
            "alignment": "center"
          }
        }
      },
      "block_order": ["heading", "body"]
    }
  ]
}
{% endschema %}