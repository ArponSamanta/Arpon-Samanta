{% liquid
  assign strip_id = section.id | append: '-strip'
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile
  assign media_layout = section.settings.media_layout

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  if section.settings.strip_background != blank
    render 'contrast-override', background_color: section.settings.strip_background, section_id: strip_id, preset: 'ui'
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--full-width
    gift-banner
    gift-banner--{{ media_layout }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  data-testid="gift-banner"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if media_layout == 'cover' and desktop_image != blank %}
      --gift-banner-ratio: {{ desktop_image.aspect_ratio }};
    {% endif %}
    {% if mobile_image != blank %}
      --gift-banner-mobile-ratio: {{ mobile_image.aspect_ratio }};
    {% endif %}
    --gift-cta-hover-background: {{ section.settings.button_hover_background }};
    --gift-cta-hover-text: {{ section.settings.button_hover_text }};
  "
>
  <div class="gift-banner__stage">
    {%- comment -%}
      Two-row layout (the design): the same illustration is drawn twice. The upper
      copy is bottom-aligned to the middle of the stage, the lower copy starts at the
      middle and is pushed right, which leaves the lower-left corner clear for the text.
      Both copies share one URL, so the file is downloaded once.
    {%- endcomment -%}
    <div class="gift-banner__media">
      {% if desktop_image != blank %}
        <picture class="gift-banner__art gift-banner__art--upper">
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w,
                {{ mobile_image | image_url: width: 1500 }} 1500w
              "
              sizes="100vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
          {% endif %}
          {{
            desktop_image
            | image_url: width: 3840
            | image_tag:
              class: 'gift-banner__image',
              widths: '750, 1100, 1440, 1920, 2880, 3840',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: desktop_image.alt
          }}
        </picture>

        {% if media_layout == 'rows' %}
          {{
            desktop_image
            | image_url: width: 3840
            | image_tag:
              class: 'gift-banner__art gift-banner__art--lower',
              widths: '750, 1100, 1440, 1920, 2880, 3840',
              sizes: '100vw',
              loading: 'lazy',
              alt: ''
          }}
        {% endif %}
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'gift-banner__art gift-banner__art--placeholder' }}
      {% endif %}
    </div>

    {%- comment -%} Desktop: one white panel, bottom-left. Mobile: the panel dissolves. {%- endcomment -%}
    <div class="gift-banner__panel">
      <div
        class="gift-banner__content gap-style"
        style="{% render 'gap-style', value: section.settings.content_gap %}"
      >
        {% content_for 'blocks' %}
      </div>

      <div class="gift-banner__cta gift-cta">
        {% content_for 'block', type: 'button', id: 'cta' %}
      </div>
    </div>
  </div>

  <div class="gift-banner__strip{% if section.settings.strip_background != blank %} color-custom-{{ strip_id }}{% endif %}">
    {% content_for 'block', type: 'text', id: 'strip' %}
  </div>
</div>

{% stylesheet %}
  .gift-banner {
    /* 67px and 52px at the 1440 frame, scaling down on smaller screens */
    --gift-banner-inset: clamp(1.25rem, 4.65vw, 4.1875rem);
    --gift-banner-bottom: clamp(1.5rem, 3.6vw, 3.25rem);
    /* How far right the lower copy of the illustration starts */
    --gift-banner-lower-offset: 38%;
    --gift-cta-height: 50px;
  }

  .gift-banner__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    aspect-ratio: var(--gift-banner-ratio, 1440 / 780);
    overflow: hidden;
  }

  .gift-banner__media {
    position: absolute;
    inset: 0;
  }

  .gift-banner__art {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  .gift-banner__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Two rows: upper copy ends at the middle, lower copy starts there */
  .gift-banner--rows .gift-banner__art--upper {
    bottom: 50%;
  }

  .gift-banner--rows .gift-banner__art--lower {
    top: 50%;
    left: var(--gift-banner-lower-offset);
  }

  /* Cover: a single image fills the stage */
  .gift-banner--cover .gift-banner__art--upper,
  .gift-banner__art--placeholder {
    inset: 0;
    height: 100%;
  }

  .gift-banner--cover .gift-banner__image {
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Text and button share one panel on the page background, bottom-left */
  .gift-banner__panel {
    grid-row: 2;
    justify-self: start;
    position: relative;
    z-index: var(--layer-flat);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: min(100%, 36rem);
    padding: var(--padding-xl) var(--padding-xl) var(--gift-banner-bottom) var(--gift-banner-inset);
    background-color: var(--color-background);
  }

  .gift-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap);
  }

  .gift-banner__cta {
    margin-block-start: var(--padding-2xl);
  }

  .gift-banner__strip {
    display: flex;
    justify-content: center;
    padding: var(--padding-xs) var(--padding-md);
  }

  /* Mobile: text centred above the illustration, button over its lower edge */
  @media screen and (max-width: 749px) {
    .gift-banner__stage {
      grid-template-rows: auto auto;
      aspect-ratio: auto;
    }

    .gift-banner__panel {
      display: contents;
    }

    .gift-banner__content {
      --text-align-default: center;

      grid-row: 1;
      align-items: center;
      padding: var(--padding-2xl) var(--padding-md) var(--padding-lg);
    }

    .gift-banner__media {
      position: relative;
      inset: auto;
      grid-row: 2;
      grid-column: 1;
      aspect-ratio: var(--gift-banner-mobile-ratio, 3 / 2);
      overflow: hidden;
    }

    .gift-banner__art--lower {
      display: none;
    }

    .gift-banner .gift-banner__art--upper {
      inset: 0;
      height: 100%;
    }

    .gift-banner .gift-banner__image {
      height: 100%;
      object-fit: cover;
      object-position: 25% 50%;
    }

    .gift-banner__cta {
      grid-row: 2;
      grid-column: 1;
      align-self: end;
      justify-self: center;
      position: relative;
      z-index: var(--layer-flat);
      margin-block: 0 var(--padding-2xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "text"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Image layout",
      "options": [
        {
          "value": "rows",
          "label": "Two rows, text corner clear"
        },
        {
          "value": "cover",
          "label": "Fill the banner"
        }
      ],
      "default": "rows",
      "info": "Two rows repeats a wide illustration and keeps the lower-left corner free for the text."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Replaces the image on small screens."
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "strip_background",
      "label": "Bottom strip background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#FFF544"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Gift banner",
      "settings": {
        "media_layout": "rows",
        "content_gap": 24
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<p>The Gift Guide</p>",
            "type_preset": "h1"
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>",
            "type_preset": "paragraph"
          }
        },
        "cta": {
          "type": "button",
          "name": "Button",
          "static": true,
          "settings": {
            "label": "SHOP NOW",
            "style_class": "button"
          }
        },
        "strip": {
          "type": "text",
          "name": "Bottom strip",
          "static": true,
          "settings": {
            "text": "<p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.75rem",
            "case": "uppercase",
            "width": "100%",
            "alignment": "center"
          }
        }
      },
      "block_order": ["heading", "body"]
    }
  ]
}
{% endschema %}